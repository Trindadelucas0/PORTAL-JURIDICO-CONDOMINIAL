DB_HOST=localhost
DB_PORT=5432
DB_NAME=PORTAL-JURIDICO
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5432/PORTAL-JURIDICO?schema=public
# Integração Vitest (ingest/escritorio) recusa este nome de banco. Use outro database para esses testes.

SEED_ADMIN_PASSWORD=
# Opcional. O seed não cria funcionário; use Equipe na UI.
SEED_FUNCIONARIO_PASSWORD=

SESSION_SECRET=

# Origem HTTPS pública (Cloudflare Tunnel). Vazio no notebook.
# Em produção (compose.prod) é obrigatório — CSRF compara Origin com este valor.
APP_PUBLIC_URL=

# Evolution (Docker compose nesta pasta — não é o Postgres PORTAL-JURIDICO)
# URL/APIKEY vazios → erro "Evolution Baileys não configurada". Imagem: evoapicloud/evolution-api:v2.2.3
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_APIKEY=change-me
EVOLUTION_WEBHOOK_SECRET=change-me
EVOLUTION_INSTANCE=juricon
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-only
# Notebook: Next no host. VPS (compose.prod): http://juricon-app:3000/api/webhooks/evolution
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3010/api/webhooks/evolution
# Diagnóstico: 1 = loga o JSON autenticado do webhook no stdout (prefixo evo-webhook-dump). Ausente ou outro valor = off. Não loga o header de secret.

# Só VPS / docker-compose.prod.yml
JURICON_POSTGRES_PASSWORD=
JURICON_HOST_PORT=3010

NODE_ENV=development
