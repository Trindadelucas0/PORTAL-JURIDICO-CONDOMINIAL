# Comentário: um # sem aspas corta o valor da linha. Se o valor tiver #, use aspas.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=PORTAL-JURIDICO
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5433/PORTAL-JURIDICO?schema=public
# Notebook: o Postgres Windows em 5432 não tem `vector`. Suba `pnpm db:pgvector-up`
# (pgvector/pgvector:pg18 na porta 5433) e aponte DATABASE_URL/DB_PORT para 5433.
# VPS continua com juricon-postgres (pg16) no compose.prod, sem porta no host.
# Integração Vitest (ingest/escritorio) recusa este nome de banco. Use outro database para esses testes.

SEED_ADMIN_PASSWORD=
# Opcional. O seed não cria funcionário; use Equipe na UI.
SEED_FUNCIONARIO_PASSWORD=

SESSION_SECRET=

# Origem HTTPS pública (Cloudflare Tunnel). Vazio no notebook.
# Em produção (compose.prod) é obrigatório — CSRF compara Origin com este valor.
APP_PUBLIC_URL=

# Evolution (Docker compose nesta pasta — não é o Postgres PORTAL-JURIDICO)
# URL/APIKEY vazios → erro "Evolution Baileys não configurada". Imagem: evoapicloud/evolution-api:v2.2.3
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_APIKEY=change-me
EVOLUTION_WEBHOOK_SECRET=change-me
EVOLUTION_INSTANCE=juricon
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_POSTGRES_PASSWORD=change-me-evolution-only
# Notebook: Next no host. VPS (compose.prod): http://juricon-app:3000/api/webhooks/evolution
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3010/api/webhooks/evolution
# Diagnóstico: 1 = loga o JSON autenticado do webhook no stdout (prefixo evo-webhook-dump). Ausente ou outro valor = off. Não loga o header de secret.

# Só VPS / docker-compose.prod.yml
JURICON_POSTGRES_PASSWORD=
JURICON_HOST_PORT=3010

NODE_ENV=development

# IA operacional. Tudo desligado por padrão. Sem chave, o worker não inventa resposta.
# JURICON_REDIS_* é broker de job (fila), não cache da inbox e não é o Redis da Evolution.
# Notebook NVIDIA NIM: AI_PROVIDER=nvidia e AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
# A chave fica só em .env (gitignored). Não cole AI_API_KEY neste arquivo.
JURICON_REDIS_URL=
JURICON_REDIS_PASSWORD=
AI_ENABLED=false
AI_RAG_ENABLED=false
AI_MEMORY_ENABLED=false
AI_AUTO_DRAFT_ENABLED=false
# Ignoradas: o código devolve false sempre (contrato v14). true no .env não liga.
AI_WHATSAPP_SEND_ENABLED=false
AI_CREATE_TICKET_ENABLED=false
AI_COST_MICROS_PER_TOKEN=0
# Token vazio → GET /api/metrics responde 404. Não coloque valor real neste arquivo.
METRICS_TOKEN=
# Opcional. Sem URL o scan é pulado (SCAN_SKIPPED). Com URL, infectado não grava.
CLAMAV_URL=
AI_PROVIDER=
AI_API_BASE_URL=
AI_API_KEY=
# Apoio de complete(): se a base primária falhar (HTTP, timeout ou rede), tenta uma vez.
# Chave só no .env. Não cole AI_API_KEY_BACKUP aqui.
# Vazio no código = https://generativelanguage.googleapis.com/v1beta/openai e gemini-2.5-flash.
# embed() não usa estas variáveis.
AI_API_KEY_BACKUP=
AI_API_BASE_URL_BACKUP=
AI_MODEL_BACKUP=
AI_MODEL_CLASSIFY=
# Chat na API hospedada da NVIDIA. meta/llama-3.1-70b-instruct responde 410.
# Id em uso no notebook: nvidia/nemotron-3-super-120b-a12b
AI_MODEL_MAIN=
# Timeout do chat (complete). Padrão 120000. Embed usa AI_EMBED_TIMEOUT_MS (padrão 25000).
AI_TIMEOUT_MS=120000
AI_EMBED_TIMEOUT_MS=25000
# Tokens de saída do JSON. Padrão 4096. Não confundir com o teto diário abaixo.
AI_MAX_OUTPUT_TOKENS=4096
# Blocos do RAG. Mudar exige pnpm db:reindex-chunks.
AI_CHUNK_CHARS=1000
AI_CHUNK_OVERLAP=150
# Distância máxima aceita na faixa de confiança. Padrão 0.75 até calibrar com documento real.
AI_RETRIEVAL_DISTANCE_LIMIT=0.75
# RAG no pgvector exige 1536 dimensões. Na NVIDIA (ativo): nvidia/llama-nemotron-embed-vl-1b-v2
# RAG no pgvector exige 1536 dimensões. Na NVIDIA (ativo): nvidia/llama-nemotron-embed-vl-1b-v2
# (o provider envia dimensions=1536; passage no índice e query na busca).
AI_MODEL_EMBED=
# Vazio = inbound-v3 (resposta curta de WhatsApp). inbound-v2 volta ao prompt anterior.
AI_PROMPT_VERSION=
AI_MAX_INPUT_TOKENS_PER_INTERACTION=6000
AI_MAX_INTERACTIONS_PER_TICKET_PER_DAY=40
AI_MAX_TOKENS_PER_DAY=200000

