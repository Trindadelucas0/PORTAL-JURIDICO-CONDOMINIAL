generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  funcionario
}

enum ChannelType {
  evolution_baileys
  evolution_cloud
  dev_mock
}

enum ConnectionStatus {
  close
  connecting
  open
}

enum MessageDirection {
  in
  out
}

enum MessageVisibility {
  publica
  interna
}

enum SendStatus {
  pending
  sent
  failed
  draft
}

enum TriageStatus {
  aberto
  arquivado
  promovido
}

enum TicketStatus {
  aberto
  em_andamento
  aguardando
  resolvido
}

enum TicketPriority {
  baixa
  media
  alta
  urgente
}

enum TicketCategory {
  cobranca
  assembleia
  obras
  vizinhanca
  administrativo
  outro
}

enum TicketOrigin {
  whatsapp
  manual
}

enum IngestStatus {
  stored
  pending_index
  indexed
  skipped
  failed
}

enum DocumentKind {
  convencao
  regimento
  ata_assembleia
  edital
  contrato
  procuracao
  parecer
  notificacao
  correspondencia
  evidencia
  audio
  outro
}

enum DeadlineKind {
  atendimento
  juridico
}

enum ContactIdentityKind {
  phone
  lid
}

enum AutomationTrigger {
  first_message_of_day
}

enum AutomationExecutionStatus {
  reserved
  sent
  failed
  skipped
}

model User {
  id                   String             @id @default(uuid()) @db.Uuid
  email                String             @unique
  nome                 String             @default("")
  passwordHash         String
  role                 UserRole
  ativo                Boolean            @default(true)
  podeResponderCliente Boolean            @default(true)
  apenasRascunho       Boolean            @default(false)
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sessions             SessionToken[]
  assignedTickets      Ticket[]           @relation("TicketAssignee")
  createdTickets       Ticket[]           @relation("TicketCreator")
  uploadedDocuments         OfficeDocument[]
  uploadedSystemDocuments   SystemDocument[]
  conversationReads         ConversationRead[]
  auditEvents          AuditEvent[]
  aiAuditEvents        AiAuditEvent[]
}

model SessionToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Condominium {
  id            String                @id @default(uuid()) @db.Uuid
  nome          String
  cnpj          String?
  endereco      String?
  cidadeUf      String?
  observacao    String?
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contacts      Contact[]
  memberships   ContactCondominium[]
  conversations Conversation[]
  tickets       Ticket[]
  documents     OfficeDocument[]
  documentChunks DocumentChunk[]
  aiRules       AiCondominiumRule[]
}

model Contact {
  id            String                @id @default(uuid()) @db.Uuid
  nome          String
  phoneE164     String                @unique
  email         String?
  cargo         String?
  avatarKey     String?
  condominiumId String?               @db.Uuid
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  condominium   Condominium?          @relation(fields: [condominiumId], references: [id])
  memberships   ContactCondominium[]
  conversations Conversation[]
  tickets       Ticket[]
  identities    ContactIdentity[]
  aiContactMemories AiContactMemory[]
  automationExecutions AutomationExecution[]

  @@index([phoneE164])
  @@index([condominiumId])
}

model ContactCondominium {
  id            String      @id @default(uuid()) @db.Uuid
  contactId     String      @db.Uuid
  condominiumId String      @db.Uuid
  createdAt     DateTime    @default(now())
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([contactId, condominiumId])
  @@index([contactId])
  @@index([condominiumId])
}

model ContactIdentity {
  id        String               @id @default(uuid()) @db.Uuid
  contactId String               @db.Uuid
  kind      ContactIdentityKind
  value     String               @unique
  createdAt DateTime             @default(now())
  contact   Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ChannelConnection {
  id            String           @id @default(uuid()) @db.Uuid
  type          ChannelType
  status        ConnectionStatus @default(close)
  label         String
  metadataJson  Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations Conversation[]
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  contactId      String?            @db.Uuid
  condominiumId  String?            @db.Uuid
  connectionId   String             @db.Uuid
  peerPhoneE164    String
  peerLid          String?
  peerDisplayName  String?
  peerAvatarKey    String?
  peerAvatarFetchedAt DateTime?
  unidentified     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  contact        Contact?           @relation(fields: [contactId], references: [id])
  condominium    Condominium?       @relation(fields: [condominiumId], references: [id])
  connection     ChannelConnection  @relation(fields: [connectionId], references: [id])
  messages       Message[]
  triageItem     TriageItem?
  tickets        Ticket[]
  reads          ConversationRead[]
  aiJobs         AiJob[]
  aiInteractions AiInteraction[]
  aiTicketMemory AiTicketMemory?
  aiTicketMemoryRevisions AiTicketMemoryRevision[]
  aiAuditEvents  AiAuditEvent[]
  automationExecutions AutomationExecution[]

  @@unique([connectionId, peerPhoneE164])
  @@index([updatedAt])
  @@index([connectionId])
  @@index([contactId])
  @@index([unidentified])
  @@index([peerPhoneE164])
  @@index([peerLid])
}

model Message {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  ticketId       String?             @db.Uuid
  replyToId      String?             @db.Uuid
  direction      MessageDirection
  visibility     MessageVisibility
  waMessageId    String?             @unique
  sendStatus     SendStatus          @default(pending)
  automated      Boolean             @default(false)
  body           String
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?             @relation(fields: [ticketId], references: [id])
  replyTo        Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("MessageReply")
  attachments    MessageAttachment[]
  aiDraftFor     AiInteraction?          @relation("AiDraft")
  aiMemoryLinks  AiTicketMemoryMessage[]
  automationInbound  AutomationExecution[] @relation("AutomationInbound")
  automationOutbound AutomationExecution[] @relation("AutomationOutbound")

  @@index([conversationId, createdAt])
  @@index([ticketId])
  @@index([waMessageId])
  @@index([sendStatus])
  @@index([replyToId])
}

model MessageAttachment {
  id           String  @id @default(uuid()) @db.Uuid
  messageId    String  @db.Uuid
  storageKey   String
  mime         String
  sizeBytes    Int
  originalName String
  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TriageItem {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @unique @db.Uuid
  ticketId       String?         @unique @db.Uuid
  status         TriageStatus    @default(aberto)
  category       TicketCategory?
  priority       TicketPriority?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?         @relation(fields: [ticketId], references: [id])

  @@index([status])
}

model Ticket {
  id             String           @id @default(uuid()) @db.Uuid
  protocol       String           @unique
  title          String
  status         TicketStatus     @default(aberto)
  priority       TicketPriority
  category       TicketCategory
  origin         TicketOrigin
  condominiumId  String           @db.Uuid
  contactId      String           @db.Uuid
  conversationId String?          @db.Uuid
  assignedToId   String?          @db.Uuid
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  condominium    Condominium      @relation(fields: [condominiumId], references: [id])
  contact        Contact          @relation(fields: [contactId], references: [id])
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  assignedTo     User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy      User             @relation("TicketCreator", fields: [createdById], references: [id])
  triageItem     TriageItem?
  messages       Message[]
  documents      OfficeDocument[]
  deadlines      Deadline[]
  aiInteractions AiInteraction[]
  aiTicketMemories AiTicketMemory[]
  aiMemoryRevisions AiTicketMemoryRevision[]
  aiAuditEvents  AiAuditEvent[]

  @@index([assignedToId])
  @@index([status])
  @@index([condominiumId])
  @@index([conversationId])
}

model OfficeDocument {
  id            String       @id @default(uuid()) @db.Uuid
  condominiumId String       @db.Uuid
  ticketId      String?      @db.Uuid
  uploadedById  String       @db.Uuid
  kind          DocumentKind
  title         String
  purpose       String
  notes         String?
  storageKey    String       @unique
  mime          String
  sizeBytes     Int
  originalName  String
  sha256        String
  ingestStatus  IngestStatus @default(stored)
  indexedAt     DateTime?
  clientSendable Boolean     @default(false)
  contentRevision Int        @default(1)
  ragEnabled    Boolean      @default(true)
  effectiveFrom DateTime?
  effectiveUntil DateTime?
  ragPriority   Int          @default(0)
  version       Int          @default(1)
  supersedesDocumentId String? @db.Uuid
  createdAt     DateTime     @default(now())
  condominium   Condominium  @relation(fields: [condominiumId], references: [id])
  ticket        Ticket?      @relation(fields: [ticketId], references: [id])
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  supersedesDocument OfficeDocument? @relation("DocumentVersion", fields: [supersedesDocumentId], references: [id])
  supersededBy  OfficeDocument[] @relation("DocumentVersion")
  chunks        DocumentChunk[]
  aiMemoryDocuments AiTicketMemoryDocument[]

  @@index([condominiumId])
  @@index([ticketId])
  @@index([ingestStatus])
  @@index([condominiumId, kind])
}

model SystemDocumentCategory {
  id        String           @id @default(uuid()) @db.Uuid
  nome      String           @unique
  createdAt DateTime         @default(now())
  documents SystemDocument[]
}

model SystemDocument {
  id            String                  @id @default(uuid()) @db.Uuid
  categoryId    String                  @db.Uuid
  uploadedById  String                  @db.Uuid
  title         String
  purpose       String
  whenToUse     String
  searchHints   String
  storageKey    String                  @unique
  mime          String
  sizeBytes     Int
  originalName  String
  sha256        String
  ingestStatus  IngestStatus            @default(stored)
  indexedAt     DateTime?
  createdAt     DateTime                @default(now())
  category      SystemDocumentCategory  @relation(fields: [categoryId], references: [id])
  uploadedBy    User                    @relation(fields: [uploadedById], references: [id])
  chunks        DocumentChunk[]

  @@index([categoryId])
}

model Deadline {
  id        String       @id @default(uuid()) @db.Uuid
  ticketId  String       @db.Uuid
  title     String
  dueAt     DateTime
  kind      DeadlineKind
  doneAt    DateTime?
  alertedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([dueAt])
  @@index([ticketId])
}

model ConversationRead {
  userId         String       @db.Uuid
  conversationId String       @db.Uuid
  lastReadAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model AutomationRule {
  id               String            @id @default(uuid()) @db.Uuid
  nome             String
  trigger          AutomationTrigger
  ativo            Boolean           @default(false)
  body             String
  startsAt         String
  endsAt           String
  skipActiveTicket Boolean           @default(true)
  activatedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  executions       AutomationExecution[]

  @@unique([trigger])
}

model AutomationExecution {
  id                String                    @id @default(uuid()) @db.Uuid
  ruleId            String                    @db.Uuid
  contactId         String                    @db.Uuid
  conversationId    String                    @db.Uuid
  businessDate      String                    @db.VarChar(10)
  status            AutomationExecutionStatus
  reason            String?
  inboundMessageId  String                    @db.Uuid
  outboundMessageId String?                   @db.Uuid
  errorCode         String?
  executedAt        DateTime?
  createdAt         DateTime                  @default(now())
  rule              AutomationRule            @relation(fields: [ruleId], references: [id])
  contact           Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inboundMessage    Message                   @relation("AutomationInbound", fields: [inboundMessageId], references: [id], onDelete: Cascade)
  outboundMessage   Message?                  @relation("AutomationOutbound", fields: [outboundMessageId], references: [id], onDelete: SetNull)

  @@unique([ruleId, contactId, businessDate])
  @@index([createdAt])
  @@index([ruleId, status])
}

model AiCondominiumRule {
  id            String      @id @default(uuid()) @db.Uuid
  condominiumId String      @db.Uuid
  version       Int
  body          String
  createdAt     DateTime    @default(now())
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, version])
  @@index([condominiumId, version])
}

model DocumentChunk {
  id               String          @id @default(uuid()) @db.Uuid
  officeDocumentId String?         @db.Uuid
  systemDocumentId String?         @db.Uuid
  condominiumId    String?         @db.Uuid
  corpus           String
  pageNumber       Int?
  chunkIndex       Int
  content          String
  contentHash      String
  embedding        Unsupported("vector(1536)")?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  officeDocument   OfficeDocument? @relation(fields: [officeDocumentId], references: [id], onDelete: Cascade)
  systemDocument   SystemDocument? @relation(fields: [systemDocumentId], references: [id], onDelete: Cascade)
  condominium      Condominium?    @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  citations        AiCitation[]

  @@unique([officeDocumentId, contentHash])
  @@unique([systemDocumentId, contentHash])
  @@index([condominiumId, active])
  @@index([systemDocumentId])
}

model AiJob {
  id               String        @id @default(uuid()) @db.Uuid
  type             String
  idempotencyKey   String        @unique
  conversationId   String?       @db.Uuid
  officeDocumentId String?       @db.Uuid
  status           String        @default("queued")
  attempts         Int           @default(0)
  runAfter         DateTime      @default(now()) @db.Timestamptz(3)
  lockedAt         DateTime?     @db.Timestamptz(3)
  lastErrorCode    String?
  rerun            Boolean       @default(false)
  payload          Json?
  createdAt        DateTime      @default(now())
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([conversationId])
}

model AiInteraction {
  id              String        @id @default(uuid()) @db.Uuid
  conversationId  String        @db.Uuid
  ticketId        String?       @db.Uuid
  idempotencyKey  String        @unique
  status          String
  riskLevel       String?
  model           String?
  inputTokens     Int           @default(0)
  outputTokens    Int           @default(0)
  costMicros      Int           @default(0)
  draftMessageId  String?       @unique @db.Uuid
  analysisJson    Json?
  contextVersion  String        @default("inbound-v1")
  createdAt       DateTime      @default(now())
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket          Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  draftMessage    Message?      @relation("AiDraft", fields: [draftMessageId], references: [id], onDelete: SetNull)
  citations       AiCitation[]
  revisions       AiTicketMemoryRevision[]
  auditEvents     AiAuditEvent[]

  @@index([conversationId, createdAt])
  @@index([ticketId])
}

model AiCitation {
  id            String        @id @default(uuid()) @db.Uuid
  interactionId String        @db.Uuid
  chunkId       String        @db.Uuid
  rank          Int
  distance      Float?
  documentId    String?       @db.Uuid
  pageNumber    Int?
  interaction   AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([interactionId])
  @@index([chunkId])
}

model AiTicketMemory {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @unique @db.Uuid
  ticketId       String?      @db.Uuid
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
}

model AiTicketMemoryRevision {
  id            String                   @id @default(uuid()) @db.Uuid
  conversationId String                  @db.Uuid
  ticketId      String?                  @db.Uuid
  version       Int
  interactionId String?                  @db.Uuid
  summaryJson   Json
  createdAt     DateTime                 @default(now())
  conversation  Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket        Ticket?                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  interaction   AiInteraction?           @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  messages      AiTicketMemoryMessage[]
  documents     AiTicketMemoryDocument[]

  @@unique([conversationId, version])
  @@index([ticketId, version])
}

model AiTicketMemoryMessage {
  revisionId String                 @db.Uuid
  messageId  String                 @db.Uuid
  revision   AiTicketMemoryRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  message    Message                @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([revisionId, messageId])
}

model AiTicketMemoryDocument {
  id               String                 @id @default(uuid()) @db.Uuid
  revisionId       String                 @db.Uuid
  officeDocumentId String                 @db.Uuid
  pageNumber       Int?
  revision         AiTicketMemoryRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  officeDocument   OfficeDocument         @relation(fields: [officeDocumentId], references: [id], onDelete: Cascade)

  @@index([revisionId])
}

model AiContactMemory {
  id                  String    @id @default(uuid()) @db.Uuid
  contactId           String    @db.Uuid
  fact                String
  sourceInteractionId String?   @db.Uuid
  confidence          String
  status              String    @default("proposed")
  createdAt           DateTime  @default(now())
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, status])
}

model AiAuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  action         String
  conversationId String?        @db.Uuid
  ticketId       String?        @db.Uuid
  jobId          String?        @db.Uuid
  interactionId  String?        @db.Uuid
  actorId        String?        @db.Uuid
  result         String
  createdAt      DateTime       @default(now())
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  interaction    AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([ticketId, createdAt])
  @@index([action])
}
