generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  funcionario
}

enum ChannelType {
  evolution_baileys
  evolution_cloud
  dev_mock
}

enum ConnectionStatus {
  close
  connecting
  open
}

enum MessageDirection {
  in
  out
}

enum MessageVisibility {
  publica
  interna
}

enum SendStatus {
  pending
  sent
  failed
  draft
}

enum TriageStatus {
  aberto
  arquivado
  promovido
}

enum TicketStatus {
  aberto
  em_andamento
  aguardando
  resolvido
}

enum TicketPriority {
  baixa
  media
  alta
  urgente
}

enum TicketCategory {
  cobranca
  assembleia
  obras
  vizinhanca
  administrativo
  outro
}

enum TicketOrigin {
  whatsapp
  manual
}

enum IngestStatus {
  stored
  pending_index
  indexed
  skipped
}

enum DocumentKind {
  convencao
  regimento
  ata_assembleia
  edital
  contrato
  procuracao
  parecer
  notificacao
  correspondencia
  evidencia
  audio
  outro
}

enum DeadlineKind {
  atendimento
  juridico
}

enum ContactIdentityKind {
  phone
  lid
}

model User {
  id                   String             @id @default(uuid()) @db.Uuid
  email                String             @unique
  nome                 String             @default("")
  passwordHash         String
  role                 UserRole
  ativo                Boolean            @default(true)
  podeResponderCliente Boolean            @default(true)
  apenasRascunho       Boolean            @default(false)
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  sessions             SessionToken[]
  assignedTickets      Ticket[]           @relation("TicketAssignee")
  createdTickets       Ticket[]           @relation("TicketCreator")
  uploadedDocuments         OfficeDocument[]
  uploadedSystemDocuments   SystemDocument[]
  conversationReads         ConversationRead[]
  auditEvents          AuditEvent[]
}

model SessionToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Condominium {
  id            String                @id @default(uuid()) @db.Uuid
  nome          String
  cnpj          String?
  endereco      String?
  cidadeUf      String?
  observacao    String?
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contacts      Contact[]
  memberships   ContactCondominium[]
  conversations Conversation[]
  tickets       Ticket[]
  documents     OfficeDocument[]
}

model Contact {
  id            String                @id @default(uuid()) @db.Uuid
  nome          String
  phoneE164     String                @unique
  email         String?
  cargo         String?
  avatarKey     String?
  condominiumId String?               @db.Uuid
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  condominium   Condominium?          @relation(fields: [condominiumId], references: [id])
  memberships   ContactCondominium[]
  conversations Conversation[]
  tickets       Ticket[]
  identities    ContactIdentity[]

  @@index([phoneE164])
  @@index([condominiumId])
}

model ContactCondominium {
  id            String      @id @default(uuid()) @db.Uuid
  contactId     String      @db.Uuid
  condominiumId String      @db.Uuid
  createdAt     DateTime    @default(now())
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([contactId, condominiumId])
  @@index([contactId])
  @@index([condominiumId])
}

model ContactIdentity {
  id        String               @id @default(uuid()) @db.Uuid
  contactId String               @db.Uuid
  kind      ContactIdentityKind
  value     String               @unique
  createdAt DateTime             @default(now())
  contact   Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ChannelConnection {
  id            String           @id @default(uuid()) @db.Uuid
  type          ChannelType
  status        ConnectionStatus @default(close)
  label         String
  metadataJson  Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations Conversation[]
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  contactId      String?            @db.Uuid
  condominiumId  String?            @db.Uuid
  connectionId   String             @db.Uuid
  peerPhoneE164    String
  peerLid          String?
  peerDisplayName  String?
  peerAvatarKey    String?
  peerAvatarFetchedAt DateTime?
  unidentified     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  contact        Contact?           @relation(fields: [contactId], references: [id])
  condominium    Condominium?       @relation(fields: [condominiumId], references: [id])
  connection     ChannelConnection  @relation(fields: [connectionId], references: [id])
  messages       Message[]
  triageItem     TriageItem?
  tickets        Ticket[]
  reads          ConversationRead[]

  @@unique([connectionId, peerPhoneE164])
  @@index([updatedAt])
  @@index([connectionId])
  @@index([contactId])
  @@index([unidentified])
  @@index([peerPhoneE164])
  @@index([peerLid])
}

model Message {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @db.Uuid
  ticketId       String?             @db.Uuid
  replyToId      String?             @db.Uuid
  direction      MessageDirection
  visibility     MessageVisibility
  waMessageId    String?             @unique
  sendStatus     SendStatus          @default(pending)
  body           String
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?             @relation(fields: [ticketId], references: [id])
  replyTo        Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("MessageReply")
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([ticketId])
  @@index([waMessageId])
  @@index([sendStatus])
  @@index([replyToId])
}

model MessageAttachment {
  id           String  @id @default(uuid()) @db.Uuid
  messageId    String  @db.Uuid
  storageKey   String
  mime         String
  sizeBytes    Int
  originalName String
  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TriageItem {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @unique @db.Uuid
  ticketId       String?         @unique @db.Uuid
  status         TriageStatus    @default(aberto)
  category       TicketCategory?
  priority       TicketPriority?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         Ticket?         @relation(fields: [ticketId], references: [id])

  @@index([status])
}

model Ticket {
  id             String           @id @default(uuid()) @db.Uuid
  protocol       String           @unique
  title          String
  status         TicketStatus     @default(aberto)
  priority       TicketPriority
  category       TicketCategory
  origin         TicketOrigin
  condominiumId  String           @db.Uuid
  contactId      String           @db.Uuid
  conversationId String?          @db.Uuid
  assignedToId   String?          @db.Uuid
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  condominium    Condominium      @relation(fields: [condominiumId], references: [id])
  contact        Contact          @relation(fields: [contactId], references: [id])
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  assignedTo     User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy      User             @relation("TicketCreator", fields: [createdById], references: [id])
  triageItem     TriageItem?
  messages       Message[]
  documents      OfficeDocument[]
  deadlines      Deadline[]

  @@index([assignedToId])
  @@index([status])
  @@index([condominiumId])
  @@index([conversationId])
}

model OfficeDocument {
  id            String       @id @default(uuid()) @db.Uuid
  condominiumId String       @db.Uuid
  ticketId      String?      @db.Uuid
  uploadedById  String       @db.Uuid
  kind          DocumentKind
  title         String
  purpose       String
  notes         String?
  storageKey    String       @unique
  mime          String
  sizeBytes     Int
  originalName  String
  sha256        String
  ingestStatus  IngestStatus @default(stored)
  indexedAt     DateTime?
  createdAt     DateTime     @default(now())
  condominium   Condominium  @relation(fields: [condominiumId], references: [id])
  ticket        Ticket?      @relation(fields: [ticketId], references: [id])
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])

  @@index([condominiumId])
  @@index([ticketId])
  @@index([ingestStatus])
  @@index([condominiumId, kind])
}

model SystemDocumentCategory {
  id        String           @id @default(uuid()) @db.Uuid
  nome      String           @unique
  createdAt DateTime         @default(now())
  documents SystemDocument[]
}

model SystemDocument {
  id            String                  @id @default(uuid()) @db.Uuid
  categoryId    String                  @db.Uuid
  uploadedById  String                  @db.Uuid
  title         String
  purpose       String
  whenToUse     String
  searchHints   String
  storageKey    String                  @unique
  mime          String
  sizeBytes     Int
  originalName  String
  sha256        String
  createdAt     DateTime                @default(now())
  category      SystemDocumentCategory  @relation(fields: [categoryId], references: [id])
  uploadedBy    User                    @relation(fields: [uploadedById], references: [id])

  @@index([categoryId])
}

model Deadline {
  id        String       @id @default(uuid()) @db.Uuid
  ticketId  String       @db.Uuid
  title     String
  dueAt     DateTime
  kind      DeadlineKind
  doneAt    DateTime?
  alertedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([dueAt])
  @@index([ticketId])
}

model ConversationRead {
  userId         String       @db.Uuid
  conversationId String       @db.Uuid
  lastReadAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}
